{
  "name": "handorff-github-io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir dist/worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "miniflare": "5.20261023.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
